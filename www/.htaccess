# Schakel mod_rewrite in
RewriteEngine On

# Zorg dat alles via HTTPS gaat
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Forceer 1 versie van je domein (zonder www)
RewriteCond %{HTTP_HOST} ^www\.amina-moutalibova\.be [NC]
RewriteRule ^(.*)$ https://amina-moutalibova.be/$1 [L,R=301]

# Redirect index.html naar de root
RewriteCond %{THE_REQUEST} \s/+index\.html [NC]
RewriteRule ^index\.html$ / [R=301,L]
